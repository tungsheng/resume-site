---
// A GitHub-dark shell block with lightly tokenized syntax coloring. No JS.
// The tokenizer itself lives in command-tokens.ts so it is unit-testable —
// this file is markup and styles (CONTEXT.md: derivation logic belongs in a
// module, never in .astro frontmatter).
import { tokenize } from "./command-tokens";

interface Props {
  command: string;
  ariaLabel?: string;
}
const { command, ariaLabel = "Command" } = Astro.props;

const tokens = tokenize(command);
---

<pre class="cmd" aria-label={ariaLabel}><code>{tokens.map((t) => <span class={`tok tok--${t.kind}`}>{t.text}</span>)}</code></pre>

<style>
  .cmd {
    margin: 0;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background-color: #0d1117;
    border: 1px solid #30363d;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    color: #e6edf3;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .cmd code {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }
  .tok--program { color: #7ee787; font-weight: 600; }
  .tok--flag { color: #79c0ff; font-weight: 600; }
  .tok--value { color: #a5d6ff; font-weight: 500; }
  .tok--variable,
  .tok--assignment { color: #ffa657; font-weight: 500; }
  .tok--separator { color: #ff7b72; font-weight: 600; }
  .tok--comment { color: #8b949e; font-style: italic; }
</style>
